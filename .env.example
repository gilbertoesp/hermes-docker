# ==============================================================================
# CONFIGURACIÓN DE ENTORNO Y SECRETOS DE HERMES (.env)
# Copia este archivo como .env en ~/.hermes/.env y completa con tus valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEEDOR LLM (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-tu-clave-de-openrouter-aqui

# ------------------------------------------------------------------------------
# 2. INTEGRACIÓN CON GITHUB (Token de Agente Granular)
# ------------------------------------------------------------------------------
# Token de acceso personal de acceso fino (Fine-grained Personal Access Token)
GITHUB_TOKEN=github_pat_11AAAAAAA_tu_token_granular_aqui

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN DEL DASHBOARD (Servicio Web - Puerto 9119)
# ------------------------------------------------------------------------------
# Requerido al vincular la interfaz web en direcciones no-loopback (0.0.0.0)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=tu_contraseña_segura_aqui
HERMES_DASHBOARD_BASIC_AUTH_SECRET=genera_una_cadena_aleatoria_para_sesiones

# ------------------------------------------------------------------------------
# 4. API SERVER HTTP / OPENAI COMPATIBLE (Puerto 8642)
# ------------------------------------------------------------------------------
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
# Genera una clave segura ejecutando en terminal: openssl rand -hex 32
API_SERVER_KEY=tu_clave_hexadecimal_32_caracteres_generada

# ------------------------------------------------------------------------------
# 5. ORQUESTATOR DOCKER (Conexión TCP al Proxy Seguro)
# ------------------------------------------------------------------------------
# Indica a Hermes que ejecute comandos Docker a través de la red del proxy
DOCKER_HOST=tcp://docker-socket-proxy:2375
